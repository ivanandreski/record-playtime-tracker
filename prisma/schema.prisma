generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Album {
  id           BigInt         @id @default(autoincrement())
  discogsId    String?        @unique @map("discogs_id")
  name         String?
  imageUrl     String?        @map("image_url")
  releaseYear  Int            @map("release_year")
  artist       String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  releases     AlbumRelease[]

  @@map("album")
}

model AlbumRelease {
  id           BigInt        @id @default(autoincrement())
  discogsId    String?       @unique @map("discogs_id")
  isActive     Boolean       @map("is_active")
  addedOn      DateTime      @map("added_on")
  albumId      BigInt        @map("album_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  album        Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  tracks       Track[]
  playSessions PlaySession[]

  @@map("album_release")
}

model Track {
  id              BigInt             @id @default(autoincrement())
  name            String?
  position        String?
  duration        Int
  albumReleaseId  BigInt             @map("album_release_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  albumRelease    AlbumRelease       @relation(fields: [albumReleaseId], references: [id], onDelete: Cascade)
  playSessionTracks PlaySessionTrack[]

  @@map("track")
}

model Stylus {
  id           BigInt        @id @default(autoincrement())
  name         String?       @db.VarChar(50)
  description  String?
  playtime     Int
  isActive     Boolean       @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  playSessions PlaySession[]

  @@map("stylus")
}

model PlaySession {
  id             BigInt             @id @default(autoincrement())
  playtime       Int
  stylusId       BigInt             @map("stylus_id")
  albumReleaseId BigInt             @map("album_release_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  albumRelease   AlbumRelease       @relation(fields: [albumReleaseId], references: [id])
  stylus         Stylus             @relation(fields: [stylusId], references: [id])
  tracks         PlaySessionTrack[]

  @@map("play_session")
}

model PlaySessionTrack {
  id            BigInt      @id @default(autoincrement())
  playSessionId BigInt      @map("play_session_id")
  trackId       BigInt      @map("track_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  playSession   PlaySession @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  track         Track       @relation(fields: [trackId], references: [id])

  @@map("play_session_track")
}
