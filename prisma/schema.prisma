generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Shape matches the legacy EF Core database (types, constraint/index names, cascades)
// so this app can take it over in place. See README "Taking over the legacy database".

model Album {
  id          BigInt         @id(map: "pk_album") @default(autoincrement())
  discogsId   String?        @unique(map: "ix_album_discogs_id") @map("discogs_id") @db.VarChar(255)
  name        String?        @db.VarChar(255)
  imageUrl    String?        @map("image_url") @db.VarChar(255)
  releaseYear Int            @map("release_year")
  originalYear Int?          @map("original_year")
  artist      String?        @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  releases    AlbumRelease[]

  @@map("album")
}

model AlbumRelease {
  id           BigInt        @id(map: "pk_album_release") @default(autoincrement())
  discogsId    String?       @unique(map: "ix_album_release_discogs_id") @map("discogs_id") @db.VarChar(255)
  isActive     Boolean       @map("is_active")
  addedOn      DateTime      @map("added_on") @db.Timestamptz(6)
  albumId      BigInt        @map("album_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  album        Album         @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_album_release_album_album_id")
  tracks       Track[]
  playSessions PlaySession[]

  @@index([albumId], map: "ix_album_release_album_id")
  @@map("album_release")
}

model Track {
  id                BigInt             @id(map: "pk_track") @default(autoincrement())
  name              String?            @db.VarChar(255)
  position          String?            @db.VarChar(255)
  duration          Int
  albumReleaseId    BigInt             @map("album_release_id")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  albumRelease      AlbumRelease       @relation(fields: [albumReleaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_track_album_release_album_release_id")
  playSessionTracks PlaySessionTrack[]

  @@index([albumReleaseId], map: "ix_track_album_release_id")
  @@map("track")
}

model Stylus {
  id           BigInt        @id(map: "pk_stylus") @default(autoincrement())
  name         String?       @db.VarChar(50)
  description  String?       @db.VarChar(255)
  playtime     Int
  isActive     Boolean       @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  playSessions PlaySession[]

  @@map("stylus")
}

model PlaySession {
  id             BigInt             @id(map: "pk_play_session") @default(autoincrement())
  playtime       Int
  stylusId       BigInt             @map("stylus_id")
  albumReleaseId BigInt             @map("album_release_id")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  albumRelease   AlbumRelease       @relation(fields: [albumReleaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_play_session_album_release_album_release_id")
  stylus         Stylus             @relation(fields: [stylusId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_play_session_stylus_stylus_id")
  tracks         PlaySessionTrack[]

  @@index([albumReleaseId], map: "ix_play_session_album_release_id")
  @@index([stylusId], map: "ix_play_session_stylus_id")
  @@map("play_session")
}

model PlaySessionTrack {
  id            BigInt      @id(map: "pk_play_session_track") @default(autoincrement())
  playSessionId BigInt      @map("play_session_id")
  trackId       BigInt      @map("track_id")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  playSession   PlaySession @relation(fields: [playSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_play_session_track_play_session_play_session_id")
  track         Track       @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_play_session_track_track_track_id")

  @@index([playSessionId], map: "ix_play_session_track_play_session_id")
  @@index([trackId], map: "ix_play_session_track_track_id")
  @@map("play_session_track")
}
