# App
APP_PORT=3000

# Database connection string for the app
# When using docker-compose with the included db service:
DATABASE_URL=postgresql://postgres:changeme@db:5432/record_playtime
# When connecting to an external database:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# PostgreSQL service (docker-compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=record_playtime
POSTGRES_PORT=5432
