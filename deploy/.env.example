# Copy to .env on the server and fill in.

# Postgres connection (use host.docker.internal if Postgres runs on the server host)
DATABASE_URL=postgresql://user:password@host.docker.internal:5432/records

# Public URL users browse to (required, or form POSTs are rejected as cross-site)
ORIGIN=http://192.168.1.10:3000

DISCOGS_TOKEN=
DISCOGS_USERNAME=
DISCOGS_USER_AGENT=record-playtime-tracker

# Host port to publish
APP_PORT=3000

# Image tag to run (git sha from `npm run image`; roll back by setting an old one)
APP_TAG=latest
